# 智排课系统 AI 中继 · 服务端配置（复制为 .env 后填写，切勿提交）
# 监听地址：仅本机，由 nginx 反代 https://api.class.feimsg.cn/v1/
PORT=8791
HOST=127.0.0.1

# 桌面端携带的应用令牌（X-App-Token），用 `openssl rand -hex 32` 生成
APP_TOKEN=

# 上游大模型：密钥只存服务端
UPSTREAM_BASE=https://api.deepseek.com
UPSTREAM_KEY=
DEFAULT_MODEL=deepseek-flash

# 限额
MAX_TOKENS_CAP=8192
DEFAULT_MAX_TOKENS=4096
DAILY_TOKEN_BUDGET=2000000
IP_WINDOW_MS=300000
IP_MAX_REQUESTS=40
MAX_CONCURRENT=4
MAX_TOOLS=40

# 审计日志目录（默认 <app>/logs）
LOG_DIR=

# 内测邀请码（sha256，规则：去掉空格与连字符后转大写再取 sha256；留空=不启用门禁）
INVITE_CODE_HASH=
# 已登记设备的存放目录（默认 app/data，部署时排除，不会被覆盖）
DATA_DIR=
